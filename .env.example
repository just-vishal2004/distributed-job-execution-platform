# Application Environment Configuration
# Copy this file to .env and adjust values for your environment.

# Node environment: development, test, or production
NODE_ENV=development

# API server port
PORT=3001

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/meridian_dev

# Development placeholder only. Production rejects this value.
# Use a unique random secret in production.
JWT_SECRET=change_me_to_a_secure_random_string_with_at_least_32_characters

# JWT session token expiration
JWT_EXPIRES_IN=7d

# Allowed web origin for CORS
CORS_ORIGIN=http://localhost:3000

# Transactional email delivery. Leave both sender settings blank to keep
# verification delivery unavailable in development.
RESEND_API_KEY=
EMAIL_FROM=
APP_BASE_URL=http://localhost:3000

# Next.js public API URL
NEXT_PUBLIC_API_URL=http://localhost:3001

# Background worker scheduler and heartbeat intervals (milliseconds)
SCHEDULER_INTERVAL_MS=2000
HEARTBEAT_MONITOR_INTERVAL_MS=30000
HEARTBEAT_TIMEOUT_SECONDS=45

# Global job assignment has no project isolation and is disabled by default.
# Production refuses to start if this is enabled.
UNSCOPED_QUEUE_ENABLED=false

# Logging level: error, warn, info, debug
LOG_LEVEL=info
